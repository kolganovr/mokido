{
  "request": {
    "method": "GET",
    "path": "/status",
    "headers": {
      "X-Bridge-Token": "golden-test-token",
      "Origin": "https://www.figma.com"
    },
    "body": null
  },
  "status": 200,
  "headers": {
    "content-type": "application/json",
    "access-control-allow-origin": "https://www.figma.com",
    "access-control-allow-methods": "GET, POST, OPTIONS",
    "access-control-allow-headers": "Content-Type, X-Bridge-Token",
    "vary": "Origin"
  },
  "body": {
    "type": "text",
    "compact_json": true,
    "json": {
      "connected": true,
      "wsClients": 1,
      "lastPing": "<n>",
      "serverVersion": "<version>",
      "pid": "<n>",
      "targets": [
        {
          "id": "<ws_id>",
          "fileName": "Golden File",
          "pageName": "Page 2",
          "pluginVersion": "9.9.9",
          "focused": true,
          "lastSeenMsAgo": "<n>"
        }
      ],
      "limits": {
        "escalateMs": 400,
        "stalledAfterMs": 120000
      }
    }
  }
}
